# Порт HTTP-эндпоинта MCP (внутри docker-сети; наружу не публикуется)
PORT=3010

# Путь к базе контрагентов
COUNTERAGENTS_DB_PATH=/opt/data/contractors_audit.snapshot.json

# 1 — отдавать агенту полные отчёты, 0 — компактную сводку
COUNTERAGENTS_FULL_PAYLOAD=1

# Отключает защиту от DNS-rebinding (нужно в docker-сети, т.к. agent ходит по
# имени сервиса). Наружу порт MCP не публикуется — см. docker-compose.debug.yml.
MCP_ALLOW_ALL_HOSTS=1

# Логгирование: сервис пишет в stdout (docker logs собирает сам).
LOG_LEVEL=INFO
LOG_FORMAT=console
