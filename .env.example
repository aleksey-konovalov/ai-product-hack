# Переменные для интерполяции в docker-compose.yml (compose читает этот файл
# из корня проекта автоматически). Скопируйте в .env и меняйте при необходимости.
# Секреты агента живут отдельно — в services/agent/.env (см. .env.example там).

# Единственный публикуемый порт — вход пользователя (web_ui).
# 8080 популярен и может быть занят другим приложением — тогда поменяйте здесь.
WEB_UI_PORT=8080
